{
  "groups": {
    "collectable": { "default": true },
    "parts": {},
    "misc": {}
  },

  "icons": {
    "border": { "class": "fa fa-cube", "color": "red" },
    "grab":   { "class": "fa fa-hand", "color": "orange" },
    "collectable":   { "class": "fa fa-box", "color": "steelblue" },
    "interact":   { "class": "fa fa-rotate", "color": "steelblue" },
    "tool":   { "class": "fa fa-screwdriver-wrench", "color": "darkcyan" },
    "part":   { "class": "fa fa-gear", "color": "tomato" },
    "balloon":   { "class": "fa fa-egg", "color": "steelblue" },
    "flower": { "class": "fa fa-spa", "color": "deeppink" },
    "mushroom": { "class": "fa fa-chess-pawn", "color": "tan" }
  },

  "types": {
    "icon": "misc",
    "group": "misc",
    "match": {
      "path": {
        "_ENVIRONMENT_/MainMapBorder": { "icon": "border", "group": "misc", "category": "border" }
      },
      "name": {
        "^\\(Grabbable_Collectable_Prop\\)_Mushroom_": { "icon": "mushroom", "group": "collectable", "category": "mushroom" },
        "^\\(Grabbable_Collectable_Prop\\)": { "icon": "collectable", "group": "collectable", "category": "prop" },
        "^\\(Grabbable": { "icon": "grab", "group": "misc", "category": "grabbable" },
        "^\\(Interactable": { "icon": "interact", "group": "misc", "category": "interactable" },
        ".*Part_Decoration\\) Balloon": { "icon": "balloon", "group": "collectable", "category": "balloon" },
        "^\\(Part_Decoration\\)_FlowerBouquet": { "icon": "flower", "group": "collectable", "category": "flower" },
        "^\\(Tool": { "icon": "tool", "group": "collectable", "category": "tool" },
        "^\\(Part": { "icon": "part", "group": "parts", "category": "part" },
        "^\\(QuestPart\\)": { "icon": "part", "group": "parts", "category": "quest part" },
        "^MainMapBorder_ALL": { "icon": "border", "group": "misc", "category": "border" }
      }
    }
  }
}
